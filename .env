# ── Base de données PostgreSQL ─────────────────
# Option 1 : Neon (cloud, gratuit) → https://neon.tech
# Option 2 : Supabase → https://supabase.com
# Option 3 : PostgreSQL local
DATABASE_URL="file:./dev.db"

# ── NextAuth.js ────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Générez avec : openssl rand -base64 32
NEXTAUTH_SECRET="bb54Iv/0y0hmM1O7loszEv4aXG9iksrGvlJrcrfl9A8="

# ── Google OAuth (optionnel) ───────────────────
# Créez des credentials sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stockage fichiers : UploadThing (optionnel) ─
# https://uploadthing.com
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ── Emails transactionnels : Resend (optionnel) ─
# https://resend.com
